<?xml version="1.0" encoding="utf-8"?>
<Application Title="Project1">
  <Options>
    <LayoutManagerOptions RequiredFieldMark="*" />
  </Options>
  <Views>
    <DetailView Id="ApplicationUser_DetailView">
      <Layout>
        <LayoutGroup Id="Main">
          <LayoutGroup Id="Roles_Group" Removed="True" />
        </LayoutGroup>
      </Layout>
    </DetailView>
    <ListView Id="Musteri_Notlar_ListView" DetailViewId="Not_DetailView" />
    <DetailView Id="Not_DetailView">
      <Items>
        <PropertyEditor Id="Musteri" PropertyName="Musteri" IsNewNode="True" Caption="Müşteri" />
        <PropertyEditor Id="Kisi" PropertyName="Kisi" IsNewNode="True" Caption="Kişi" />
      </Items>
      <Layout>
        <LayoutGroup Id="Main" RelativeSize="100">
          <LayoutGroup Id="SimpleEditors" RelativeSize="100">
            <LayoutGroup Id="Not" RelativeSize="100">
              <LayoutItem Id="Musteri" ViewItem="Musteri" Index="0" IsNewNode="True" />
              <LayoutItem Id="Kisi" ViewItem="Kisi" Index="1" IsNewNode="True" />
              <LayoutItem Id="Baslik" Index="2" />
              <LayoutItem Id="Icerik" Index="3" />
              <LayoutItem Id="Derece" Index="4" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
    <DetailView Id="Kisi_DetailView">
      <Items>
        <PropertyEditor Id="Musteri" PropertyName="Musteri" IsNewNode="True" Caption="Müşteri" />
      </Items>
      <Layout>
        <LayoutGroup Id="Main" RelativeSize="100">
          <LayoutGroup Id="SimpleEditors" RelativeSize="100">
            <LayoutGroup Id="Kisi" RelativeSize="100">
              <LayoutItem Id="Musteri" ViewItem="Musteri" Index="0" IsNewNode="True" />
              <LayoutItem Id="Ad" Index="1" />
              <LayoutItem Id="Soyad" Index="2" />
              <LayoutItem Id="Email" Index="3" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
  </Views>
</Application>
