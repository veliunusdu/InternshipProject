<?xml version="1.0" encoding="utf-8"?>
<Application Title="Project1 CRM">
  <ActionDesign>
    <Actions>
      <Action Id="MyDetails" Active="False" />
    </Actions>
  </ActionDesign>
  <Options>
    <LayoutManagerOptions RequiredFieldMark="*" />
  </Options>
  <Views>
    <DetailView Id="ApplicationUser_DetailView" Remove="True" />
    <ListView Id="Musteri_Notlar_ListView" DetailViewId="Not_DetailView" />
    <DetailView Id="Not_DetailView">
      <Layout>
        <LayoutGroup Id="Main" RelativeSize="100" Direction="Vertical">
          <LayoutGroup Id="SimpleEditors" RelativeSize="100" Direction="Vertical">
            <LayoutGroup Id="Not" RelativeSize="100" Direction="Vertical">
              <LayoutItem Id="Musteri" Index="0" />
              <LayoutItem Id="Kisi" Index="1" />
              <LayoutItem Id="Baslik" Index="2" />
              <LayoutItem Id="Icerik" Index="3" />
              <LayoutItem Id="Derece" Index="4" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
    <DetailView Id="Kisi_DetailView">
      <Layout>
        <LayoutGroup Id="Main" RelativeSize="100" Direction="Vertical">
          <LayoutGroup Id="SimpleEditors" RelativeSize="100" Direction="Vertical">
            <LayoutGroup Id="Kisi" RelativeSize="100" Direction="Vertical">
              <LayoutItem Id="Musteri" Index="0" />
              <LayoutItem Id="Ad" Index="1" />
              <LayoutItem Id="Soyad" Index="2" />
              <LayoutItem Id="Email" Index="3" />
              <LayoutItem Id="Telefon" Index="4" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
  </Views>
</Application>
