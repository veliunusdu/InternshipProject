<?xml version="1.0" encoding="utf-8"?>
<Application StartupNavigationItem="Dashboard_View">
  <Options UIType="TabbedMDI"
         FormStyle="Ribbon"
         RestoreTabbedMdiLayout="True"
         ShowTabImage="True"
         VirtualScrollingEnabled="True">
  </Options>
  <NavigationItems NavigationStyle="Accordion">
    <Items>
      <Item Id="Default">
        <Items>
          <Item Id="Dashboard_View" ViewId="Dashboard_View" Caption="Ana Sayfa" Index="0" IsNewNode="True" ImageName="Action_Home" />
          <Item Id="Musteri_ListView" ViewId="Musteri_ListView" Caption="Müşteriler" Index="1" IsNewNode="True" />
          <Item Id="Kisi_ListView" ViewId="Kisi_ListView" Caption="Kişiler" Index="2" IsNewNode="True" />
          <Item Id="Not_ListView" ViewId="Not_ListView" Caption="Notlar" Index="3" IsNewNode="True" />
          <Item Id="Yonetim" Caption="Yönetim" Index="4" IsNewNode="True">
            <Items>
              <Item Id="UserEmailPermission_ListView" ViewId="UserEmailPermission_ListView" Caption="E-posta Yetkileri" Index="0" IsNewNode="True" />
            </Items>
          </Item>
        </Items>
      </Item>
    </Items>
  </NavigationItems>
  <Views>
    <DashboardView Id="Dashboard_View" Caption="Ana Sayfa" IsNewNode="True">
      <Items>
        <ControlDetailItem Id="DashboardCustomItem" ControlTypeName="Project1.Blazor.Server.Pages.Dashboard" IsNewNode="True" />
      </Items>
      <Layout>
        <LayoutGroup Id="Main" RelativeSize="100">
          <LayoutItem Id="DashboardCustomItem" ViewItem="DashboardCustomItem" RelativeSize="100" IsNewNode="True" />
        </LayoutGroup>
      </Layout>
    </DashboardView>
  </Views>
</Application>
