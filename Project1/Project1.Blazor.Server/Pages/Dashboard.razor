@using Project1.Module.Models.Entities
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Blazor
@using DevExpress.ExpressApp.Blazor.Editors
@using Microsoft.AspNetCore.Components.Authorization
@inject IObjectSpaceFactory ObjectSpaceFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

    <div class="dashboard-container p-3 p-md-4">
        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
            <div>
                <h3 class="fw-bold text-dark mb-1">@GreetingText</h3>
                <p class="text-secondary mb-0 fs-6">Project1 Müşteri, Kişi & Not Yönetim Portalı</p>
            </div>
            <div class="d-flex align-items-center gap-3 mt-3 mt-md-0">
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill font-monospace fs-7">
                    📅 @DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                </span>
                <button class="btn btn-outline-secondary btn-sm px-3 py-1.5 rounded-3 d-flex align-items-center gap-1" @onclick="RefreshData">
                    <span>🔄</span> Yenile
                </button>
            </div>
        </div>

        <!-- Minimal Modern Metric Cards -->
        <div class="row g-3 mb-4">
            <!-- Müşteriler -->
            <div class="col-12 col-md-4">
                <a href="/#Musteri_ListView" class="text-decoration-none">
                    <div class="card border p-4 rounded-3 bg-white shadow-xs h-100 modern-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-uppercase text-secondary fw-semibold fs-7 font-monospace">Müşteriler</span>
                            <div class="icon-circle bg-light text-primary fs-5">🏢</div>
                        </div>
                        <h2 class="fw-bold text-dark mb-1">@musteriSayisi</h2>
                        <small class="text-muted">Kayıtlı Müşteri Sayısı</small>
                    </div>
                </a>
            </div>

            <!-- Notlar -->
            <div class="col-12 col-md-4">
                <a href="/#Not_ListView" class="text-decoration-none">
                    <div class="card border p-4 rounded-3 bg-white shadow-xs h-100 modern-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-uppercase text-secondary fw-semibold fs-7 font-monospace">Notlar</span>
                            <div class="icon-circle bg-light text-indigo fs-5">📝</div>
                        </div>
                        <h2 class="fw-bold text-dark mb-1">@notSayisi</h2>
                        <small class="text-muted">Sistemdeki Not Kayıtları</small>
                    </div>
                </a>
            </div>

            <!-- Kişiler -->
            <div class="col-12 col-md-4">
                <a href="/#Kisi_ListView" class="text-decoration-none">
                    <div class="card border p-4 rounded-3 bg-white shadow-xs h-100 modern-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-uppercase text-secondary fw-semibold fs-7 font-monospace">İletişim Kişileri</span>
                            <div class="icon-circle bg-light text-teal fs-5">👥</div>
                        </div>
                        <h2 class="fw-bold text-dark mb-1">@kisiSayisi</h2>
                        <small class="text-muted">Kayıtlı Temsilciler</small>
                    </div>
                </a>
            </div>
        </div>

        <!-- Quick Shortcuts Panel -->
        <div class="card border p-4 rounded-3 bg-white shadow-xs">
            <h6 class="fw-bold text-uppercase text-secondary fs-7 font-monospace mb-3">Hızlı İşlemler</h6>
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <a href="/#Musteri_ListView" class="modern-tile">
                        <div class="fs-4 me-3">🏢</div>
                        <div>
                            <div class="fw-semibold text-dark">Müşteri Portalı</div>
                            <small class="text-muted">Müşteri listesini görüntüle</small>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a href="/#Not_ListView" class="modern-tile">
                        <div class="fs-4 me-3">📝</div>
                        <div>
                            <div class="fw-semibold text-dark">Not Yönetimi</div>
                            <small class="text-muted">Not listesini görüntüle</small>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a href="/#Kisi_ListView" class="modern-tile">
                        <div class="fs-4 me-3">👥</div>
                        <div>
                            <div class="fw-semibold text-dark">İletişim Kişileri</div>
                            <small class="text-muted">Kişi listesini görüntüle</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

@code {
    [CascadingParameter]
    public BlazorControlViewItem ViewItem { get; set; }

    private int musteriSayisi = 0;
    private int notSayisi = 0;
    private int kisiSayisi = 0;

    private string currentUserName = "";

    private string GreetingText => DateTime.Now.Hour switch
    {
        >= 5 and < 12 => "Günaydın",
        >= 12 and < 18 => "İyi Günler",
        _ => "İyi Akşamlar"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUserName = authState.User?.Identity?.Name ?? "";
        }
        catch
        {
        }
        RefreshData();
    }

    private void RefreshData()
    {
        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateObjectSpace(typeof(Musteri));
            musteriSayisi = objectSpace.GetObjectsCount(typeof(Musteri), null);
            notSayisi = objectSpace.GetObjectsCount(typeof(Not), null);
            kisiSayisi = objectSpace.GetObjectsCount(typeof(Kisi), null);
        }
        catch
        {
            // Fallback for initial startup
        }
    }
}
