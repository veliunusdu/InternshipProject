@page "/"
@namespace Project1.Blazor.Server
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using DevExpress.ExpressApp.Blazor.Components

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content="Müşteri, kişi ve not yönetim sistemi" />
    <title>Project1 CRM</title>
    <base href="~/" />
    <link rel="icon" type="image/svg+xml" href="images/Logo.svg" />
    <link rel="shortcut icon" href="images/Logo.svg" />
    <component type="typeof(BootstrapThemeLink)" render-mode="Static" />
    <link href="_content/DevExpress.ExpressApp.Blazor/styles.css" asp-append-version="true" rel="stylesheet" />
    <link href="css/site.css" asp-append-version="true" rel="stylesheet" />
</head>
<body>
    <component type="typeof(SplashScreen)" render-mode="Static" param-Caption='"Project1 CRM"' param-ImagePath='"images/SplashScreen.svg"' />

    <div id="brand-splash" class="brand-splash" role="status" aria-live="polite">
        <div class="brand-splash__glow brand-splash__glow--one"></div>
        <div class="brand-splash__glow brand-splash__glow--two"></div>
        <div class="brand-splash__content">
            <img src="images/SplashScreen.svg" alt="Project1 CRM" class="brand-splash__logo" />
            <div class="brand-splash__name">Project1 <span>CRM</span></div>
            <p>Müşteri ilişkileri çalışma alanı</p>
            <div class="brand-splash__loader" aria-hidden="true"><span></span><span></span><span></span></div>
            <small>Çalışma alanınız hazırlanıyor</small>
        </div>
    </div>

    <app class="d-none">
        <component type="typeof(App)" render-mode="Server" />
    </app>

    <component type="typeof(AlertsHandler)" render-mode="Server" />

    <div id="blazor-error-ui">
        <component type="typeof(BlazorError)" render-mode="Static" />
    </div>

    <script>
        (() => {
            const app = document.querySelector('app');
            const splash = document.getElementById('brand-splash');
            if (!app || !splash) return;

            const finish = () => {
                if (!app.classList.contains('d-none')) {
                    splash.classList.add('brand-splash--complete');
                    window.setTimeout(() => splash.remove(), 450);
                    return true;
                }
                return false;
            };

            if (!finish()) {
                new MutationObserver((_, observer) => {
                    if (finish()) observer.disconnect();
                }).observe(app, { attributes: true, attributeFilter: ['class'] });
            }
        })();

        window.initWebPushNotifications = function () {
            if ("Notification" in window && Notification.permission === "default") {
                Notification.requestPermission();
            }
        };

        window.showWebPushNotification = function (title, body) {
            if ("Notification" in window) {
                if (Notification.permission === "granted") {
                    try {
                        new Notification(title, {
                            body: body,
                            icon: "images/SplashScreen.svg",
                            badge: "images/SplashScreen.svg",
                            tag: "mail-read-" + Date.now()
                        });
                    } catch (e) {
                        console.warn("Web Push fırlatılamadı:", e);
                    }
                } else if (Notification.permission === "default") {
                    Notification.requestPermission().then(function (permission) {
                        if (permission === "granted") {
                            new Notification(title, {
                                body: body,
                                icon: "images/SplashScreen.svg"
                            });
                        }
                    });
                }
            }
        };

        // Giriş Ekranı Üst Tanıtım Çubuğu (Blazor VDOM Dışı, 100% Güvenli)
        (() => {
            let lastHasPwd = null;
            function checkLogonState() {
                const pwdInput = document.querySelector('input[type="password"]');
                const hasPwd = !!pwdInput;
                if (hasPwd === lastHasPwd) return;
                lastHasPwd = hasPwd;

                let topBar = document.getElementById('xaf-logon-top-bar');
                if (hasPwd) {
                    if (!topBar) {
                        topBar = document.createElement('div');
                        topBar.id = 'xaf-logon-top-bar';
                        topBar.className = 'xaf-logon-top-bar';
                        topBar.innerHTML = `
                            <div class="xaf-logon-top-content">
                                <span>🏢 <strong>Yeni Müşteri misiniz?</strong> Firmanız için hemen kayıt oluşturabilir ve portala erişebilirsiniz.</span>
                                <a href="/signup" class="xaf-top-signup-btn">✨ Müşteri Olarak Kayıt Ol (Sign-Up) →</a>
                            </div>
                        `;
                        document.body.appendChild(topBar);
                    }
                } else {
                    if (topBar) topBar.remove();
                }
            }

            setInterval(checkLogonState, 500);
        })();
    </script>
    <style>
        .xaf-logon-top-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 999999;
            background: linear-gradient(90deg, #1e3a8a 0%, #2563eb 100%);
            color: #ffffff;
            padding: 10px 24px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
            font-size: 13px;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: slideDown 0.3s ease-out;
        }

        .xaf-logon-top-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            width: 100%;
            max-width: 1100px;
        }

        .xaf-top-signup-btn {
            background: #ffffff;
            color: #1e40af !important;
            font-weight: 700;
            padding: 6px 18px;
            border-radius: 20px;
            text-decoration: none !important;
            white-space: nowrap;
            transition: all 0.2s ease;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .xaf-top-signup-btn:hover {
            background: #f1f5f9;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .xaf-injected-signup-box {
            margin-top: 18px;
            padding-top: 6px;
            width: 100%;
            box-sizing: border-box;
        }

        .xaf-injected-divider {
            position: relative;
            text-align: center;
            margin: 14px 0 12px 0;
        }

        .xaf-injected-divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #cbd5e1;
            z-index: 1;
        }

        .xaf-injected-divider span {
            position: relative;
            z-index: 2;
            background: #ffffff;
            padding: 0 12px;
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            letter-spacing: 0.05em;
        }

        .xaf-injected-card {
            background: #f8fafc;
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            padding: 14px 16px;
            text-align: left;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .xaf-injected-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        .xaf-injected-badge {
            background: #dbeafe;
            color: #1e40af;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 12px;
        }

        .xaf-injected-header strong {
            font-size: 13px;
            color: #0f172a;
        }

        .xaf-injected-p {
            font-size: 12px;
            color: #64748b;
            margin: 0 0 10px 0;
            line-height: 1.4;
        }

        .xaf-injected-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 9px 16px;
            background: #2563eb;
            color: #ffffff !important;
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none !important;
            transition: all 0.2s ease;
            box-shadow: 0 3px 8px rgba(37, 99, 235, 0.25);
            box-sizing: border-box;
        }

        .xaf-injected-btn:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(37, 99, 235, 0.35);
        }

        @@keyframes slideDown {
            from {
                transform: translateY(-100%);
            }
            to {
                transform: translateY(0);
            }
        }
    </style>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
