@page "/confirm-email"
@using Project1.Core.Services.Interfaces
@using Project1.DTOs.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="confirm-container">
    <div class="confirm-card">
        @if (isLoading)
        {
            <div class="confirm-loading">
                <div class="large-spinner"></div>
                <h3>E-Posta Adresiniz Doğrulanıyor...</h3>
                <p>Lütfen bekleyin, hesabınız aktifleştiriliyor.</p>
            </div>
        }
        else if (isSuccess)
        {
            <div class="confirm-result confirm-success">
                <div class="result-badge">✅</div>
                <h2>Tebrikler! Hesabınız Doğrulandı</h2>
                <p>@message</p>
                <div style="background-color: #dcfce7; padding: 12px; border-radius: 8px; margin: 16px 0; font-size: 13px; color: #14532d;">
                    💡 <strong>Giriş İpucu:</strong> Giriş ekranında <strong>"Kullanıcı Adı"</strong> kutusuna kayıt olduğunuz e-posta adresinizi ve şifrenizi girerek oturum açabilirsiniz.
                </div>
                <div class="action-box">
                    <a href="/LoginPage" class="btn-action btn-login">🔑 Giriş Ekranına Git</a>
                </div>
            </div>
        }
        else
        {
            <div class="confirm-result confirm-error">
                <div class="result-badge">❌</div>
                <h2>Doğrulama Başarısız Oldu</h2>
                <p class="error-detail">@errorMessage</p>
                <div class="action-box">
                    <a href="/signup" class="btn-action btn-signup">Yeniden Kayıt Ol</a>
                    <a href="/LoginPage" class="btn-action btn-secondary">Giriş Ekranına Dön</a>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .confirm-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        padding: 24px;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .confirm-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 480px;
        padding: 40px 32px;
        text-align: center;
    }

    .confirm-loading h3 {
        color: #0f172a;
        margin: 20px 0 8px 0;
        font-size: 20px;
    }

    .confirm-loading p {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .large-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #e2e8f0;
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto;
    }

    .result-badge {
        font-size: 54px;
        margin-bottom: 12px;
    }

    .confirm-success h2 {
        color: #15803d;
        font-size: 22px;
        margin: 0 0 10px 0;
    }

    .confirm-success p {
        color: #334155;
        font-size: 14px;
        line-height: 1.5;
    }

    .confirm-error h2 {
        color: #b91c1c;
        font-size: 22px;
        margin: 0 0 10px 0;
    }

    .error-detail {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px;
        font-size: 13px;
        margin: 16px 0;
    }

    .action-box {
        margin-top: 28px;
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn-action {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: background-color 0.2s, transform 0.1s;
    }

    .btn-login {
        background: #16a34a;
        color: white;
    }

    .btn-login:hover {
        background: #15803d;
        color: white;
    }

    .btn-signup {
        background: #2563eb;
        color: white;
    }

    .btn-signup:hover {
        background: #1d4ed8;
        color: white;
    }

    .btn-secondary {
        background: #e2e8f0;
        color: #334155;
    }

    .btn-secondary:hover {
        background: #cbd5e1;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool isLoading = true;
    private bool isSuccess = false;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!UserId.HasValue || UserId.Value == Guid.Empty || string.IsNullOrWhiteSpace(Token))
        {
            isLoading = false;
            isSuccess = false;
            errorMessage = "Doğrulama bağlantısı geçersiz veya eksik parametreler içeriyor.";
            return;
        }

        try
        {
            var result = await AuthService.ConfirmEmailAsync(UserId.Value, Token);
            isSuccess = result.Success;
            if (result.Success)
            {
                message = result.Message ?? "E-posta adresiniz başarıyla doğrulandı! Artık giriş yapabilirsiniz.";
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Doğrulama işlemi başarısız oldu.";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            errorMessage = $"İşlem sırasında hata oluştu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
