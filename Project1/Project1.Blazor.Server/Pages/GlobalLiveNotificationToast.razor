@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Project1.Core.Services.Interfaces
@inject ICrmNotificationService NotificationService
@implements IDisposable

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 99999;">
    @foreach (var toast in _activeToasts)
    {
        <div class="toast show shadow-lg border-0 mb-2" 
             style="background: #ffffff; border-left: 5px solid #28a745 !important; border-radius: 8px; min-width: 320px; box-shadow: 0 8px 24px rgba(0,0,0,0.15);" 
             role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-white border-bottom-0 pb-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">✉️</span>
                    <strong class="text-success">E-Posta Okundu!</strong>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">@toast.ReadDate.ToString("HH:mm:ss")</small>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="() => RemoveToast(toast)"></button>
                </div>
            </div>
            <div class="toast-body text-dark pt-1 pb-2">
                <div><strong>@toast.ContactName</strong> (@toast.CustomerName)</div>
                <div class="text-muted small mt-1">
                    <em>"@toast.Title"</em> başlıklı not bildirim e-postasını az önce açtı/okudu.
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<NoteReadNotificationEvent> _activeToasts = new();

    protected override void OnInitialized()
    {
        NotificationService.OnNoteRead += HandleNoteRead;
    }

    private void HandleNoteRead(NoteReadNotificationEvent evt)
    {
        InvokeAsync(() =>
        {
            _activeToasts.Add(evt);
            StateHasChanged();

            // 7 saniye sonra otomatik kaybol
            _ = Task.Delay(7000).ContinueWith(_ =>
            {
                InvokeAsync(() =>
                {
                    _activeToasts.Remove(evt);
                    StateHasChanged();
                });
            });
        });
    }

    private void RemoveToast(NoteReadNotificationEvent toast)
    {
        _activeToasts.Remove(toast);
        StateHasChanged();
    }

    public void Dispose()
    {
        NotificationService.OnNoteRead -= HandleNoteRead;
    }
}
