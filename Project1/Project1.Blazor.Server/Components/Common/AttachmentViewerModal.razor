@* Components/Common/AttachmentViewerModal.razor *@
@if (IsOpen)
{
    <div class="modal fade show d-block" style="background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 100000;" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden">
                <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5">📁</span>
                        <div>
                            <h6 class="modal-title fw-bold mb-0">@FileName</h6>
                            @if (!string.IsNullOrEmpty(ContentType))
                            {
                                <small class="text-secondary opacity-75 font-monospace">@ContentType</small>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(DownloadUrl))
                        {
                            <a href="@DownloadUrl" target="_blank" class="btn btn-outline-light btn-sm px-3 rounded-pill d-flex align-items-center gap-1">
                                <span>⬇️</span> İndir
                            </a>
                        }
                        <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseModal"></button>
                    </div>
                </div>
                <div class="modal-body p-0 text-center bg-light d-flex align-items-center justify-content-center" style="min-height: 520px; max-height: 80vh;">
                    @if (IsImage && !string.IsNullOrEmpty(FileUrl))
                    {
                        <div class="p-3 w-100 h-100 d-flex align-items-center justify-content-center">
                            <img src="@FileUrl" alt="@FileName" class="img-fluid rounded-3 shadow-sm" style="max-height: 72vh; max-width: 100%; object-fit: contain;" />
                        </div>
                    }
                    else if (IsPdf && !string.IsNullOrEmpty(FileUrl))
                    {
                        <iframe src="@FileUrl" class="w-100 h-100 border-0" style="min-height: 72vh;" title="@FileName"></iframe>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <div class="fs-1 mb-3">📄</div>
                            <h5 class="fw-bold text-dark mb-2">Bu dosya türü için tarayıcı içi önizleme kullanılamıyor</h5>
                            <p class="text-muted mb-4">Dosyayı bilgisayarınıza indirerek uygun bir program ile açabilirsiniz.</p>
                            @if (!string.IsNullOrEmpty(DownloadUrl))
                            {
                                <a href="@DownloadUrl" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" download>
                                    Dosyayı İndir (@FileName)
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public string FileUrl { get; set; } = string.Empty;
    [Parameter] public string DownloadUrl { get; set; } = string.Empty;
    [Parameter] public string ContentType { get; set; } = string.Empty;
    [Parameter] public bool IsImage { get; set; }
    [Parameter] public bool IsPdf { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
