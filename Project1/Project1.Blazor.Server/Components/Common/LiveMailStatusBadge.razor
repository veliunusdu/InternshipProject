@* Components/Common/LiveMailStatusBadge.razor *@
#nullable enable
@using Project1.Core.Enums

<span class="badge rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1 font-monospace @BadgeClass @ExtraClass" style="font-size: 0.82rem;">
    <span>@IconText</span>
    <span>@StatusText</span>
    @if (ReadDate.HasValue)
    {
        <small class="opacity-75 ms-1">(@ReadDate.Value.ToString("HH:mm:ss"))</small>
    }
</span>

@code {
    [Parameter] public MailDurumu Durum { get; set; } = MailDurumu.Gonderilmedi;
    [Parameter] public DateTime? ReadDate { get; set; }
    [Parameter] public string ExtraClass { get; set; } = string.Empty;

    private string BadgeClass => Durum switch
    {
        MailDurumu.Okundu => "bg-success-subtle text-success border border-success-subtle shadow-xs",
        MailDurumu.Iletildi => "bg-info-subtle text-info border border-info-subtle",
        MailDurumu.Gonderildi => "bg-primary-subtle text-primary border border-primary-subtle",
        MailDurumu.Basarisiz => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-light text-secondary border"
    };

    private string IconText => Durum switch
    {
        MailDurumu.Okundu => "✅",
        MailDurumu.Iletildi => "📩",
        MailDurumu.Gonderildi => "📤",
        MailDurumu.Basarisiz => "⚠️",
        _ => "⏳"
    };

    private string StatusText => Durum switch
    {
        MailDurumu.Okundu => "Okundu",
        MailDurumu.Iletildi => "İletildi",
        MailDurumu.Gonderildi => "Gönderildi",
        MailDurumu.Basarisiz => "Hata",
        _ => "Bekliyor"
    };
}
