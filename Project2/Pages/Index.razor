@page "/"
@inject HttpClient Http
@implements IDisposable

<PageTitle>Project2 - API Durum Paneli</PageTitle>

<div class="dashboard-wrapper @(IsActive ? "status-active-bg" : "status-passive-bg")">
    <div class="status-card">
        <div class="status-indicator-dot @(IsActive ? "dot-green" : "dot-red")"></div>
        
        <h2 class="title">PROJECT 1 API SERVIS DURUMU</h2>
        
        <div class="status-banner @(IsActive ? "banner-green" : "banner-red")">
            @(IsActive ? "AKTİF (ACTIVE)" : "PASİF (PASSIVE)")
        </div>

        <p class="description">
            Bu durum <strong>Project1 REST API (https://localhost:5001/api/systemstatus)</strong> üzerinden canlı olarak sorgulanmaktadır.
        </p>

        <div class="last-checked">
            Son Kontrol: @LastCheckedTime.ToString("HH:mm:ss")
        </div>
    </div>
</div>

<style>
    .dashboard-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        transition: background-color 0.5s ease;
        border-radius: 12px;
    }

    .status-active-bg {
        background-color: #e8f5e9;
    }

    .status-passive-bg {
        background-color: #ffebee;
    }

    .status-card {
        background: #ffffff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        text-align: center;
        max-width: 500px;
        width: 100%;
        position: relative;
    }

    .status-indicator-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        margin: 0 auto 15px auto;
        transition: all 0.3s ease;
    }

    .dot-green {
        background-color: #2e7d32;
        box-shadow: 0 0 12px #2e7d32;
    }

    .dot-red {
        background-color: #c62828;
        box-shadow: 0 0 12px #c62828;
    }

    .title {
        font-size: 16px;
        font-weight: 700;
        color: #555555;
        margin-bottom: 20px;
        letter-spacing: 1px;
    }

    .status-banner {
        font-size: 32px;
        font-weight: bold;
        padding: 16px 24px;
        border-radius: 8px;
        margin-bottom: 20px;
        color: #ffffff;
        transition: background-color 0.3s ease;
    }

    .banner-green {
        background-color: #2e7d32;
    }

    .banner-red {
        background-color: #c62828;
    }

    .description {
        color: #666666;
        font-size: 14px;
        line-height: 1.6;
    }

    .last-checked {
        margin-top: 15px;
        font-size: 12px;
        color: #888888;
    }
</style>

@code {
    private bool IsActive { get; set; } = false;
    private DateTime LastCheckedTime { get; set; } = DateTime.Now;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await FetchStatusAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollStatusLoopAsync();
    }

    private async Task PollStatusLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await FetchStatusAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task FetchStatusAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<StatusResponse>("api/systemstatus");
            IsActive = response?.IsActive ?? false;
        }
        catch
        {
            IsActive = false;
        }
        finally
        {
            LastCheckedTime = DateTime.Now;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
    }

    public class StatusResponse
    {
        public bool IsActive { get; set; }
        public string Status { get; set; } = string.Empty;
    }
}